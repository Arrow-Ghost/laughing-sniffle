# Copy to .env and fill in. Never commit .env (it is gitignored; this file is not).
GROQ_API_KEY=
GEMINI_API_KEY=

# --- model routing (spec §82). Each is the primary; the backend falls back
#     through a built-in list on 404 / 503. Leave blank to use the defaults. ---
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_JUDGE_MODEL=
# GEMINI_SIMILARITY_MODEL=
# GEMINI_SUMMARIZE_MODEL=

# auto    = server-side Gemini transcription when a key is set, else browser
# browser = always use the browser Web Speech API (Chrome only)
TRANSCRIPTION=auto

# Storage. SQLite via Node's built-in node:sqlite — one file, no server.
DATABASE_URL=file:./data/shadowadj.db

# External source search for the Integrity Engine (Phase 3). "mock" until a real
# provider + key is wired.
SEARCH_PROVIDER=mock

# Auth + RBAC (Phase 7). Leave BLANK for dev mode: every request runs as an admin
# and the console works with no login. Set it to any long random string to enforce
# signed tokens + roles; the first account registered then becomes the admin.
AUTH_SECRET=

PORT=8787
CORS_ORIGIN=http://localhost:4321
