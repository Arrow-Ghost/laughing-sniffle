---
import '@/styles/global.css';
const { title = 'ShadowADJ' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/console', label: 'Console' },
  { href: '/judge', label: 'Judge' },
  { href: '/review', label: 'Review' },
  { href: '/coach', label: 'Coach' },
  { href: '/admin', label: 'Admin' },
  { href: '/history', label: 'History' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Consent-first, real-time speech practice & reflection console." />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="sticky top-0 z-40 border-b border-stroke bg-ink/70 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="inline-block h-3 w-3 rounded-full bg-gradient-to-br from-cyan to-mint"></span>
          ShadowADJ
        </a>
        <nav class="flex gap-1 text-sm">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class={`rounded-lg px-3 py-1.5 transition ${
                  path === n.href ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white/90'
                }`}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-4 py-10 text-xs text-white/30">
      ShadowADJ is a reflection tool, not an adjudicator. It reports how speech sounds and never
      estimates authorship or produces a verdict about a person.
    </footer>
  </body>
</html>
