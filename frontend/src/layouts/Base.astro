---
import '@/styles/global.css';
const { title = 'ShadowADJ — Real-Time Debate Monitoring' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/console', label: 'Console' },
  { href: '/judge', label: 'Judge HUD' },
  { href: '/review', label: 'Case Review' },
  { href: '/coach', label: 'Coach' },
  { href: '/admin', label: 'Admin' },
  { href: '/history', label: 'History' },
  { href: '/about', label: 'Product Spec' },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Consent-first, real-time AI assistance monitoring & reflection console for competitive debate." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body class="min-h-screen font-sans antialiased text-slate-100 selection:bg-cyan/30 selection:text-white">
    {/* Ambient Glow Orbs */}
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div class="absolute -top-40 left-1/4 h-[500px] w-[500px] rounded-full bg-cyan/15 blur-[120px] animate-pulse-glow"></div>
      <div class="absolute top-1/3 -right-40 h-[450px] w-[450px] rounded-full bg-mint/10 blur-[130px] animate-pulse-glow" style="animation-delay: 2s;"></div>
      <div class="absolute -bottom-40 left-1/3 h-[500px] w-[500px] rounded-full bg-indigo-500/10 blur-[140px] animate-pulse-glow" style="animation-delay: 4s;"></div>
    </div>

    {/* Header Navigation Bar */}
    <header
      class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-2xl
        after:absolute after:inset-x-0 after:-bottom-px after:h-px
        after:bg-gradient-to-r after:from-transparent after:via-cyan/40 after:to-transparent"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="group flex items-center gap-3 font-heading text-lg font-bold tracking-tight text-white">
          <div class="relative flex h-8 w-8 items-center justify-center rounded-xl border border-cyan/40 bg-cyan/10 transition group-hover:border-cyan group-hover:shadow-[0_0_20px_rgba(0,212,255,0.6)]">
            <span class="h-2.5 w-2.5 rounded-full bg-cyan shadow-[0_0_10px_#00d4ff] animate-pulse"></span>
          </div>
          <span class="bg-gradient-to-r from-white via-white to-white/70 bg-clip-text text-transparent group-hover:from-white group-hover:to-cyan">
            Shadow<span class="text-cyan">ADJ</span>
          </span>
        </a>

        {/* Navigation links */}
        <nav class="hidden md:flex items-center gap-1 rounded-2xl border border-white/10 bg-white/[0.03] p-1.5 backdrop-blur-md">
          {
            nav.map((n) => {
              const active = path === n.href || (n.href !== '/' && path.startsWith(n.href));
              return (
                <a
                  href={n.href}
                  aria-current={active ? 'page' : undefined}
                  class={`relative rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all duration-200 ${
                    active
                      ? 'bg-gradient-to-r from-cyan/20 to-mint/20 text-white border border-cyan/40 shadow-[0_0_15px_rgba(0,212,255,0.25)]'
                      : 'text-slate-400 hover:text-white hover:bg-white/5'
                  }`}
                >
                  {n.label}
                </a>
              );
            })
          }
        </nav>

        {/* Status Badge */}
        <div class="flex items-center gap-2">
          <div class="hidden sm:flex items-center gap-2 rounded-full border border-mint/30 bg-mint/10 px-3 py-1 text-[11px] font-medium text-mint shadow-[0_0_12px_rgba(0,255,156,0.2)]">
            <span class="h-1.5 w-1.5 rounded-full bg-mint animate-pulse"></span>
            System Live
          </div>
          <a
            href="/judge"
            class="btn btn-primary text-xs !px-3 !py-1.5 font-semibold"
          >
            Launch HUD
          </a>
        </div>
      </div>
    </header>

    {/* Main Content Area */}
    <main class="relative z-10 min-h-[calc(100vh-10rem)]">
      <slot />
    </main>

    {/* Footer */}
    <footer class="relative z-10 border-t border-white/10 bg-slate-950/80 backdrop-blur-xl">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <span class="font-heading font-bold text-white">ShadowADJ</span>
          <span>· Real-Time AI Assistance Monitoring for Competitive Debate</span>
        </div>
        <p class="max-w-md text-center sm:text-right text-[11px] leading-relaxed text-slate-500">
          The system monitors. The speaker competes. The human adjudicator decides.
        </p>
      </div>
    </footer>
  </body>
</html>
