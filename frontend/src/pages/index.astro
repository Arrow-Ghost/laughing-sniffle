---
import Base from '@/layouts/Base.astro';

const pillars = [
  {
    title: 'Descriptive, not accusatory',
    body: 'No risk score. No “review” verdict. No guess about whether an answer was AI-assisted — that can’t be done reliably from speech and ShadowADJ doesn’t try.',
  },
  {
    title: 'Consent-first',
    body: 'A session can’t start until the person being recorded says yes. They see the exact same dashboard as everyone else in the room.',
  },
  {
    title: 'Nothing kept',
    body: 'Audio stays in memory and is discarded when the session ends. Summaries live in your browser’s local storage — no account, no server-side profile.',
  },
];

const surfaces = [
  { href: '/console', label: 'Console', note: 'Record a live answer', accent: 'text-cyan' },
  { href: '/judge', label: 'Judge', note: 'Score against a rubric', accent: 'text-cyan' },
  { href: '/review', label: 'Review', note: 'Integrity signals + evidence', accent: 'text-amber' },
  { href: '/coach', label: 'Coach', note: 'Drills from the evaluation', accent: 'text-mint' },
  { href: '/admin', label: 'Admin', note: 'Leaderboard, consensus, analytics', accent: 'text-white/70' },
];
---

<Base title="ShadowADJ — speech practice & reflection">
  <section class="relative mx-auto max-w-5xl px-4 pt-16 pb-10 sm:pt-24">
    <div
      aria-hidden
      class="pointer-events-none absolute -top-24 left-[10%] h-80 w-[46rem] rounded-full bg-gradient-to-br from-cyan/20 via-mint/10 to-transparent blur-3xl"
    >
    </div>

    <div class="relative">
      <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-cyan/80">
        Real-time speech reflection
      </p>
      <h1 class="text-gradient mt-4 max-w-3xl text-balance text-4xl font-bold leading-[1.05] sm:text-6xl">
        A mirror for how you speak — not a judge of who you are.
      </h1>
      <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-white/60 sm:text-base">
        ShadowADJ listens to a live answer and surfaces what a good coach notices: pace, pauses,
        filler words, vocabulary variety, how long you take before you start. Built for debate
        practice, interview prep and speech coaching.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/console" class="btn btn-primary">Open the console →</a>
        <a href="/about" class="btn">Why it works this way</a>
      </div>
    </div>

    <div class="relative mt-16 grid gap-4 sm:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="glass p-5 transition duration-200 ease-pop hover:-translate-y-0.5 hover:border-white/20">
            <h3 class="font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/55">{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="relative mt-14">
      <p class="metric-label">The pipeline</p>
      <div class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-5">
        {
          surfaces.map((s) => (
            <a
              href={s.href}
              class="glass group flex flex-col gap-1 p-4 transition duration-200 ease-pop hover:-translate-y-0.5 hover:border-white/20"
            >
              <span class={`text-sm font-semibold ${s.accent}`}>{s.label}</span>
              <span class="text-[12px] leading-snug text-white/45">{s.note}</span>
              <span class="mt-1 text-[11px] text-white/25 transition group-hover:text-white/45">Open →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
